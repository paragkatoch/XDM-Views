    <View name="Orders by city">
        <Projection>
            <Entity name="Customer">
                <Attribute>customer_id</Attribute>
                <Attribute>name</Attribute>
                <Attribute>city</Attribute>
            </Entity>
            <Entity name="PurchaseOrder">
                <Attribute>order_id</Attribute>
                <Attribute>amount</Attribute>
            </Entity>
        </Projection>
        <BaseEntities>
            <Entity>Customer</Entity>
            <Entity>PurchaseOrder</Entity>
        </BaseEntities>
        <RelationshipRef>CustomerPurchaseJoin</RelationshipRef>
        <Parameters>
            <Parameter name="min_orders" type="int" default="0"/>
        </Parameters>
        <Aggregation>
            <GroupBy>
                <Attribute entity="Customer">city</Attribute>
            </GroupBy>
            <Measures>
                <Measure fn="count" alias="order_count"/>
                <Measure fn="sum" entity="PurchaseOrder" attribute="amount" alias="total_amount"/>
            </Measures>
            <Having>
                <Filter alias="order_count" operator=">" value="$min_orders"/>
            </Having>
        </Aggregation>
        <OrderBy>
            <Sort alias="total_amount" direction="desc"/>
        </OrderBy>
        <Limit>5</Limit>
    </View>


</Views>